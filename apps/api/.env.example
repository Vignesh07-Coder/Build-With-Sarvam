# apps/api environment configuration
# Copy to .env and fill in real values. Never commit the real .env file.
# Validated at startup by src/config/env.ts (Zod) — see docs/environment-variables.md.

# ---- Required application configuration (safe defaults shown) ----
NODE_ENV=development
PORT=4000
# Must match the frontend's origin exactly; CORS is not relaxed for convenience (CLAUDE.md §5).
CORS_ORIGIN=http://localhost:3000

# ---- Optional integrations ----
# Server never starts blocked on these being present (CLAUDE.md §5/§6).
# Do not fabricate values — leave blank until a real Sarvam/Supabase project exists.
# NOTE: without SUPABASE_URL/SUPABASE_ANON_KEY, /health still responds, but
# every /api/v1/* route returns 503 ("auth_not_configured") — see
# src/middleware/auth.middleware.ts.

# Secret. Never exposed to the browser. Read only by the Sarvam adapter (docs/ARCHITECTURE.md §6.5).
SARVAM_API_KEY=

# Supabase project URL (same value used by the frontend's NEXT_PUBLIC_SUPABASE_URL).
SUPABASE_URL=

# Public anon key, used to construct the request-scoped Supabase client and
# to verify caller access tokens in the auth middleware.
SUPABASE_ANON_KEY=

# Secret. Used ONLY by the privileged Stamina service client (docs/ARCHITECTURE.md §6.3).
# Never prefix a variable like this with NEXT_PUBLIC_ and never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Secret, operator-only. Required (as the x-internal-ingestion-key header) by the
# source-ingestion write endpoints (POST /api/v1/sources/ingest, POST /api/v1/sources/:contentId/process),
# which otherwise reach the privileged admin client behind nothing but ordinary (including anonymous)
# auth. Leave unset to disable those endpoints entirely (503) until a trusted operator value is set.
INTERNAL_INGESTION_KEY=
