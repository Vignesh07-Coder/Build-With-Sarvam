{
  "name": "@tattva/api",
  "version": "0.1.0",
  "private": true,
  "description": "Tattva backend — Express + TypeScript API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.48.1",
    "@tattva/contracts": "workspace:*",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "sarvamai": "^1.1.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
