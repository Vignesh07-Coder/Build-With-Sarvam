# apps/web environment configuration
# Copy to .env.local and fill in real values. Never commit the real file.
# See docs/environment-variables.md for the full reference.
#
# Only NEXT_PUBLIC_* variables belong here — anything prefixed NEXT_PUBLIC_
# is bundled into client-side JavaScript and is NOT a safe place for secrets
# (CLAUDE.md §5). Supabase's anon key is intentionally public; it is safe
# only because Supabase RLS enforces per-row access (docs/DATABASE.md §10).

# ---- Required application configuration ----
# Base URL of apps/api. Used by lib/api-client.ts.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Optional integrations ----
# Leave blank until a real Supabase project exists (CLAUDE.md §6: optional
# integration credentials must not block the basic app from starting).
# NOTE: without these, lib/auth.ts throws AuthNotConfiguredError when a
# component tries to establish a session — the app still renders fixtures.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
